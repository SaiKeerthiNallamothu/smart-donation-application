{
  "info": {
    "_postman_id": "smart-donation-collection-006",
    "name": "Smart Donation API",
    "description": "Smart Donation Spring Boot backend API.\n\n## Flow\n1. Register → 2. Verify Email → 3. Login → 4. Create Profile\n\n## Variables\n- {{base_url}} = http://localhost:8080\n- {{admin_token}} = auto-saved after login\n- {{admin_refresh_token}} = auto-saved after login\n- {{donor_token}} = auto-saved after login\n- {{ngo_token}} = auto-saved after login\n- {{volunteer_token}} = auto-saved after login\n- {{ngo_profile_id}} = auto-saved after profile create\n- {{donor_profile_id}} = auto-saved after profile create\n- {{volunteer_profile_id}} = auto-saved after profile create",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080", "type": "string" },
    { "key": "admin_token", "value": "", "type": "string" },
    { "key": "admin_refresh_token", "value": "", "type": "string" },
    { "key": "donor_token", "value": "", "type": "string" },
    { "key": "ngo_token", "value": "", "type": "string" },
    { "key": "volunteer_token", "value": "", "type": "string" },
    { "key": "ngo_profile_id", "value": "", "type": "string" },
    { "key": "donor_profile_id", "value": "", "type": "string" },
    { "key": "volunteer_profile_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Auth",
      "description": "Register → Verify Email → Login. Change role/email/password in body as needed.",
      "item": [
        {
          "name": "1.1 Register",
          "description": "Register a new user. Change role to DONOR, NGO, VOLUNTEER, or ADMIN.",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Priya\",\n  \"lastName\": \"Sharma\",\n  \"email\": \"priya@test.com\",\n  \"phone\": \"9876543210\",\n  \"password\": \"Donor@123\",\n  \"confirmPassword\": \"Donor@123\",\n  \"role\": \"DONOR\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "1.2 Verify Email",
          "description": "Enter the OTP sent to the registered email.",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priya@test.com\",\n  \"otp\": \"000000\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/verify-email",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "verify-email"]
            }
          },
          "response": []
        },
        {
          "name": "1.3 Login",
          "description": "Login and auto-save token. Change email/password to match your registered user.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    var role = jsonData.role;",
                  "    pm.collectionVariables.set('admin_token', jsonData.token);",
                  "    pm.collectionVariables.set('admin_refresh_token', jsonData.refreshToken);",
                  "    if (role === 'DONOR') {",
                  "        pm.collectionVariables.set('donor_token', jsonData.token);",
                  "        console.log('donor_token saved');",
                  "    } else if (role === 'NGO') {",
                  "        pm.collectionVariables.set('ngo_token', jsonData.token);",
                  "        console.log('ngo_token saved');",
                  "    } else if (role === 'VOLUNTEER') {",
                  "        pm.collectionVariables.set('volunteer_token', jsonData.token);",
                  "        console.log('volunteer_token saved');",
                  "    } else {",
                  "        console.log('admin_token saved');",
                  "    }",
                  "}",
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priya@test.com\",\n  \"password\": \"Donor@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "1.4 Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{admin_refresh_token}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/refresh-token",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "refresh-token"]
            }
          },
          "response": []
        },
        {
          "name": "1.5 Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priya@test.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "forgot-password"]
            }
          },
          "response": []
        },
        {
          "name": "1.6 Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"priya@test.com\",\n  \"otp\": \"000000\",\n  \"newPassword\": \"Donor@456\",\n  \"confirmPassword\": \"Donor@456\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/reset-password",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "reset-password"]
            }
          },
          "response": []
        },
        {
          "name": "1.7 Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{admin_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          },
          "response": []
        }
      ]
    },
